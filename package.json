{
  "name": "fun-run-website",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "prettier": "@rr/config/prettier",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "pnpm --filter @rr/e2e e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json}\""
  },
  "devDependencies": {
    "@rr/config": "workspace:*",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
