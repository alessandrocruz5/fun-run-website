# Copy to packages/db/.env (gitignored). Laptop only.
#
# Neon owner connection for `pnpm --filter @rr/db db:migrate`: the DIRECT (non-pooled) URL of the
# branch you are migrating, from Neon Console → Connect (role neondb_owner, pooling off). Never
# set this in Vercel.
MIGRATE_DATABASE_URL=

# The organizer dashboard's two accounts, for `pnpm --filter @rr/db seed:organizers` (16-128
# characters each). The owner password comes from your password manager. The demo viewer's pair
# also goes into the admin app's Vercel project, for the "Explore the organizer demo" button.
ORGANIZER_OWNER_EMAIL=
ORGANIZER_OWNER_PASSWORD=
DEMO_VIEWER_EMAIL=
DEMO_VIEWER_PASSWORD=
#
# The app's own `DATABASE_URL` (pooled, `rr_app_login`) belongs in Vercel and apps/web/.env.local,
# not here.
