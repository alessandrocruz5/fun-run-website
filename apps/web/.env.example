# Copy to apps/web/.env.local (gitignored).
#
# `next build` must never need any of these: they are read per request, so CI and Vercel build
# with no environment variables.

# Public origin, no trailing slash. Absolute URLs in metadata, robots.txt, sitemap.xml and the
# share image, and PayMongo's success/cancel redirects. Required at runtime: without it those
# return 500 and pages lose their metadata.
SITE_URL=http://localhost:3000

# Neon pooled URL for the app's login role (rr_app_login), never the owner. Local and Preview use
# the `dev` branch, Production uses `main`. See docs/runbook.md#migrations.
DATABASE_URL=

# PayMongo test secret key (Developers → API keys, test mode). Anything not starting `sk_test_`
# is rejected. Server only: never give it a NEXT_PUBLIC_ prefix.
PAYMONGO_SECRET_KEY=

# PayMongo webhook secret key (Developers → Webhooks → the test-mode webhook → secret key). Only
# /api/webhooks/paymongo reads it; the form and success page work without it. Set it in Vercel
# Production, where the webhook points. Server only: never give it a NEXT_PUBLIC_ prefix.
PAYMONGO_WEBHOOK_SECRET=

# Cloudflare Turnstile (dash.cloudflare.com → Turnstile → the widget). The site key is public; it
# is read per request and handed to the form. Without it the form shows "registration is paused".
# For local dev and CI, Cloudflare's test keys: site `1x00000000000000000000AA` with secret
# `1x0000000000000000000000000000000AA` always passes; `2x00000000000000000000AB` with
# `2x0000000000000000000000000000000AA` always fails. Never deploy the test keys: always-pass
# switches the bot check off.
TURNSTILE_SITE_KEY=
# Secret key for the same widget. Server only: never give it a NEXT_PUBLIC_ prefix. Without it every
# registration is refused.
TURNSTILE_SECRET_KEY=

# Resend (resend.com → API Keys): a key with "Sending access" for the verified domain only. Sends
# the one confirmation email after payment, from the success page or the webhook. Without it (or
# EMAIL_FROM), confirming a payment fails: the webhook answers 500 and the success page says it
# couldn't check. Server only: never give it a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=
# Sender on a domain verified in Resend (SPF + DKIM), e.g. `Riverline Run <race@mail.example.com>`.
# Locally, `Riverline Run <onboarding@resend.dev>` works, but only to your Resend account's email.
EMAIL_FROM=
