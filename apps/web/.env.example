# Copy to apps/web/.env.local (gitignored).
#
# `next build` must never need any of these: they are read per request, so CI and Vercel build
# with no environment variables.

# Public origin, no trailing slash. Absolute URLs in metadata, robots.txt, sitemap.xml and the
# share image. Required at runtime: without it those return 500 and pages lose their metadata.
SITE_URL=http://localhost:3000
