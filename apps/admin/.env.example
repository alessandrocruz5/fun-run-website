# Copy to apps/admin/.env.local (gitignored).
#
# `next build` must never need any of these: they are read per request, so CI and Vercel build
# with no environment variables. They belong to the admin app's own Vercel project only: the public
# site (apps/web) never gets a login secret.

# Neon pooled URL for the dashboard's login role (rr_admin_login): it can only read registrations,
# plus the auth tables. Never the owner or rr_app_login. Local and Preview use the `dev` branch,
# Production uses `main`. See docs/runbook.md#organizer-dashboard.
DATABASE_URL=

# Signs session cookies: `openssl rand -base64 32` (at least 32 characters). Server only: never give
# it a NEXT_PUBLIC_ prefix. Changing it signs every organizer out.
BETTER_AUTH_SECRET=zS09miV7RdMipAGbiZ+xIQIxQUeW/P9WFXFzcfJI+Cg=
# The dashboard's public origin, no trailing slash. Sign-in only trusts requests from it.
BETTER_AUTH_URL=http://localhost:3001

# The demo viewer account that `pnpm --filter @rr/db seed:organizers` creates: the same values as in
# packages/db/.env. "Explore the organizer demo" signs in with them on the server; the password
# never reaches the browser. Without them the button is disabled. Server only.
DEMO_VIEWER_EMAIL=
DEMO_VIEWER_PASSWORD=
